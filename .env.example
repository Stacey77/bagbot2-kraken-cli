# Kraken API credentials - get them from https://www.kraken.com/u/security/api
# NEVER commit a real .env file. Copy this file to .env and fill in your keys.
KRAKEN_API_KEY=your_api_key_here
KRAKEN_API_SECRET=your_api_secret_here

# Dry-run (paper trading) mode. When true, no real orders are sent to Kraken.
# Set to false (or pass --live on the CLI) to place real orders.
BAGBOT_DRY_RUN=true

# Optional: override the Kraken REST base URL (e.g. for testing)
# KRAKEN_BASE_URL=https://api.kraken.com
